# Auth0 tenant (custom domain if configured, otherwise <tenant>.<region>.auth0.com)
AUTH0_DOMAIN=your-tenant.region.auth0.com
# Client ID of the Auth0 application that has the "SAML2 Web App" addon enabled
AUTH0_CLIENT_ID=your-client-id
# SP entity ID, must equal the addon's "audience"
SP_ENTITY_ID=urn:saml-demo-sp
# Where this app is reachable (ACS = $APP_BASE_URL/saml/acs, SLO = $APP_BASE_URL/saml/slo)
APP_BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=change-me (openssl rand -hex 32)
